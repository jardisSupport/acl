{
    "name": "jardissupport/acl",
    "homepage": "https://jardis.io",
    "description": "Per-record access entries (information kind, record, group, level) on a SQL table for PHP DDD applications — grant, revoke, level lookup and group reassignment built from jardissupport/dbquery and jardissupport/repository, framework-free, no transaction of its own",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Jardis Development",
            "email": "jardisDev@headgent.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "jardissupport/contracts": "^2.21",
        "jardissupport/dbquery": "^1.3.1",
        "jardissupport/repository": "^1.10"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5.63",
        "phpstan/phpstan": "2.2.3",
        "squizlabs/php_codesniffer": "3.13.6",
        "jardisadapter/dbconnection": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "JardisSupport\\Acl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JardisSupport\\Acl\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/jardisSupport/acl/issues",
        "docs": "https://docs.jardis.io/en/support/acl",
        "email": "jardisDev@headgent.com"
    },
    "keywords": [
        "acl",
        "access-control",
        "authorization",
        "permissions",
        "php",
        "domain-driven-design",
        "hexagonal-architecture",
        "jardis",
        "headgent"
    ]
}
